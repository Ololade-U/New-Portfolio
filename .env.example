# EmailJS credentials — get these from https://dashboard.emailjs.com/
# 1. Add an Email Service (e.g. connect your Gmail) -> copy its Service ID
# 2. Create an Email Template with {{name}}, {{email}}, {{message}} variables -> copy its Template ID
# 3. Account > General -> copy your Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
